# Copy to .env and fill in. Never commit the real .env.

# Neon connection string (Dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Shared household login
HOUSEHOLD_PASSWORD=change-me
HOUSEHOLD_MEMBERS=Guilherme,Lazia

# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# false only when running locally over http://
COOKIE_SECURE=false
